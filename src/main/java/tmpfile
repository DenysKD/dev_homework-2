while (true) {
            if (!scanner.hasNextByte()) {
                logger.info("Invalid value");
                scanner.next();
                continue;
            }

            input = scanner.nextByte();

            if (input > 0 && input < 10) {
                if (box[input - 1] == 'X' || box[input - 1] == 'O')
                    logger.info("That one is already in use. Enter another.");
                else {
                    box[input - 1] = 'X';
                    break;
                }
            } else
                logger.info("Invalid input. Enter again.");
        }